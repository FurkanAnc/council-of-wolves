# --- Option 1: Anthropic API (default) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Option 2: Anthropic-compatible provider ---
# Leave ANTHROPIC_API_KEY empty and fill these in instead.
# ANTHROPIC_BASE_URL=https://platform.yeta.ai
# ANTHROPIC_AUTH_TOKEN=<your-provider-key>
# ANTHROPIC_MODEL=koray-1.0

# Optional overrides
# OPUS_MODEL=...           # model for Uzman, Şüpheci, Başkan
# SONNET_MODEL=...         # model for Pratik, Şeytanın Avukatı, titles
# MAX_TOKENS=8192          # stages 1-2 (default 16000; 8192 with a custom base URL)
# CHAIRMAN_MAX_TOKENS=8192 # stage 3 (default 32000; 8192 with a custom base URL)
# HOST=127.0.0.1           # backend address; 0.0.0.0 exposes it to your network (no auth!)
# PORT=8001
# DATA_DIR=...             # conversation folder (default: data/conversations in the project)
